# Required in production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=your-app.example.com
DJANGO_DEBUG=0

# Local development
# DJANGO_DEBUG=1
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional
# REDIS_URL=redis://localhost:6379/0
# OSRM_BASE_URL=https://router.project-osrm.org      # self-host for production
OPEN_METEO_API_KEY=                                 # commercial plan lifts free-tier limits
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
# WIND_METRIC=sustained                               # or "gust"
# TRUCK_DURATION_MULTIPLIER=1.15
# HEATMAP_MAX_POINTS=240
# HTTP_USER_AGENT=weather-route-planner/1.0 (you@example.com)
